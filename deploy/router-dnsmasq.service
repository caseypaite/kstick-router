[Unit]
Description=KStick LAN DHCP and DNS (dnsmasq)
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/router/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/etc/router/dnsmasq.conf --pid-file=
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

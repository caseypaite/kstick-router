[Unit]
Description=KStick public SMS gateway (published by cloudflared)
After=network.target ModemManager.service
Wants=ModemManager.service

[Service]
ExecStart=/usr/local/sbin/kstick-smsgw
User=smsgw
Group=smsgw
# polkit (/etc/polkit-1/rules.d/50-kstick-smsgw.rules) lets this user send SMS via ModemManager, nothing else.
StateDirectory=smsgw
StateDirectoryMode=0750
Restart=always
RestartSec=3
Environment=GOMEMLIMIT=16MiB
MemoryMax=40M
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target

[Unit]
Description=KStick compressed swap in RAM (zram, lz4)
DefaultDependencies=no
After=systemd-modules-load.service
Before=swap.target
ConditionPathExists=!/dev/zram0

[Service]
Type=oneshot
RemainAfterExit=yes
# 128 MB of swap space; at ~2.5:1 lz4 compression it costs ~50 MB of RAM when full.
ExecStart=/usr/sbin/modprobe zram num_devices=1
ExecStart=/bin/sh -c 'echo lz4 > /sys/block/zram0/comp_algorithm && echo 128M > /sys/block/zram0/disksize'
ExecStart=/usr/sbin/mkswap -q -L zram0 /dev/zram0
ExecStart=/usr/sbin/swapon -p 100 /dev/zram0
ExecStop=/usr/sbin/swapoff /dev/zram0
ExecStop=/bin/sh -c 'echo 1 > /sys/block/zram0/reset'

[Install]
WantedBy=swap.target
